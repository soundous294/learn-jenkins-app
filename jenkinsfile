stage('test') {
    agent {
        docker {
            image 'node:18-alpine'
            reuseNode true
        }
    }
    steps {
        sh '''
            test -f build/index.html
            mkdir -p test-results
            JEST_JUNIT_OUTPUT_DIR=test-results \
            JEST_JUNIT_OUTPUT_NAME=junit.xml \
            npm test -- --watchAll=false
            ls -la test-results
        '''
    }
    post {
        always {
            junit 'test-results/junit.xml'
        }
    }
}